            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>

        <button
          class="mobile-menu-btn"
          id="mobile-menu-btn"
          aria-label="Menu"
          title="Abrir menu"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <div class="header-nav-wrap" id="header-nav-wrap">
          <nav>
            <a href="/" class={currentPath === "" ? "nav-active" : ""}>Home</a>
            <a href="/blog" class={currentPath.startsWith("/blog") ? "nav-active" : ""}>Blog</a>
            <a href="/sobre" class={currentPath.startsWith("/sobre") ? "nav-active" : ""}>Sobre</a>
            <a href="/contato" class={currentPath.startsWith("/contato") ? "nav-active" : ""}>Contato</a>
          </nav>

          <div class="header-actions">
            <button
              class="header-icon-btn"
              id="search-toggle"
              aria-label="Buscar"
              title="Buscar"
            >
