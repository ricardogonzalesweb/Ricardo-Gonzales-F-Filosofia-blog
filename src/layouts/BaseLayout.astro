    </header>

    <!-- ── Search Modal ─────────────────────────── -->
    <div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Buscar artigos">
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-box">
