        --color-muted: #9a9997;
        --color-border: rgba(255, 255, 255, 0.08);
        --color-shadow: rgba(0, 0, 0, 0.4);
        --color-accent: #f65700;
        --color-accent-subtle: rgba(246, 87, 0, 0.12);
        --color-accent-hover: rgba(246, 87, 0, 0.2);
        --color-code-bg: #1e1c2e;
        --color-callout-bg: #1a1828;
        --color-placeholder-bg: linear-gradient(135deg, #3b1002, #1b0b04);
        --color-placeholder-text: #f65700;
        --scrollbar-track: #1b1918;
        --scrollbar-thumb: #f65700;
        --scrollbar-thumb-hover: #d74800;
      }

      /* ── Reset ─────────────────────────────────── */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        margin: 0;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        transition: background 0.2s, color 0.2s;
        line-height: 1.6;
      }

      * {
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
      }

      *::-webkit-scrollbar {
        width: 12px;
        height: 12px;
      }

      *::-webkit-scrollbar-track {
        background: var(--scrollbar-track);
      }

      *::-webkit-scrollbar-thumb {
        background: var(--scrollbar-thumb);
        border-radius: 999px;
        border: 3px solid var(--scrollbar-track);
      }

      *::-webkit-scrollbar-thumb:hover {
        background: var(--scrollbar-thumb-hover);
      }

      img {
        max-width: 100%;
        display: block;
      }
      a {
        color: inherit;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--color-accent);
      }

      /* ── Container ─────────────────────────────── */
      .container {
        width: 100%;
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-bg) 85%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: background 0.2s ease, backdrop-filter 0.2s ease;
      }

      .site-header.menu-open {
        background: var(--color-bg);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }

      .site-header .container {
        height: 64px;
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        letter-spacing: -0.01em;
        flex-shrink: 0;
        white-space: nowrap;
      }

      .logo-icon {
        width: 1.25rem;
        height: 1.25rem;
        object-fit: contain;
      }

      .logo-text-full {
        display: inline;
        max-width: 32ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .logo-subtext {
        font-weight: 500;
        opacity: 0.8;
        margin-left: 0.25rem;
      }

      /* ── Mobile menu button ──────────────────── */
      .mobile-menu-btn {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 38px;
        height: 38px;
        padding: 8px;
        background: transparent;
        border: none;
        cursor: pointer;
        margin-left: auto;
        flex-shrink: 0;
        z-index: 110;
      }

      .hamburger-line {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--color-text);
        border-radius: 2px;
        transition: transform 0.3s, opacity 0.3s;
      }

      .mobile-menu-btn.active .hamburger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .mobile-menu-btn.active .hamburger-line:nth-child(2) {
        opacity: 0;
      }
      .mobile-menu-btn.active .hamburger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      /* ── Header nav wrapper ──────────────────── */
      .header-nav-wrap {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex: 1;
      }

      .site-header nav {
        display: flex;
        gap: 0.4rem;
        flex: 1;
        margin-left: 0.5rem;
      }

      .site-header nav a {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.15s, background 0.15s;
        padding: 0.35em 0.85em;
        border-radius: 6px;
      }

      .site-header nav a:hover {
        color: var(--color-text);
      }

      .site-header nav a.nav-active {
        background: var(--color-accent-subtle);
        color: var(--color-accent);
        font-weight: 600;
        border: 1px solid rgba(246, 87, 0, 0.25);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
        flex-shrink: 0;
      }

      .header-icon-btn {
        background: transparent;
        border: none;
        border-radius: 10px;
        padding: 0.5em;
        width: 38px;
        height: 38px;
        cursor: pointer;
        color: var(--color-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, background 0.2s, transform 0.2s;
        flex-shrink: 0;
      }

      .mobile-theme-toggle {
        display: none;
      }

      .header-icon-btn:hover {
        color: var(--color-accent);
        background: var(--color-accent-subtle);
        transform: translateY(-1px);
      }

      .header-icon-btn svg {
        width: 18px;
        height: 18px;
      }

      .header-icon-btn .theme-icon--dark {
        display: none;
      }

      [data-theme="dark"] .header-icon-btn .theme-icon--light {
        display: none;
      }

      [data-theme="dark"] .header-icon-btn .theme-icon--dark {
        display: inline;
      }

      .btn-newsletter {
        display: inline-flex;
        align-items: center;
        padding: 0.5em 1.2em;
        background: var(--color-accent);
        color: #fff;
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 50px;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        white-space: nowrap;
        border: none;
        cursor: pointer;
      }

      .btn-newsletter:hover {
        background: #d74800;
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(246, 87, 0, 0.35);
      }

      /* ── Main ──────────────────────────────────── */
      .site-main {
        flex: 1;
      }

      /* ── Footer ────────────────────────────────── */
      .site-footer {
        background: #1a1714;
        color: #f0ede8;
        padding: 0;
        margin-top: 4rem;
        border-top: none;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
        gap: 2.5rem;
        padding: 3.5rem 0 3rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .footer-logo {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        color: #f0ede8;
        white-space: nowrap;
      }

      .footer-logo:hover {
        color: var(--color-accent);
      }

      .footer-desc {
        font-size: 0.82rem;
        color: #9a9997;
        line-height: 1.6;
        margin: 0;
        max-width: 260px;
      }

      .footer-col-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #9a9997;
        margin: 0 0 1.2rem;
      }

      .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .footer-links a {
        font-size: 0.85rem;
        color: #c5c3bf;
        text-decoration: none;
        transition: color 0.15s;
      }

      .footer-links a:hover {
        color: var(--color-accent);
      }

      .footer-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .social-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #c5c3bf;
        text-decoration: none;
        transition: background 0.2s, color 0.2s, transform 0.2s,
          border-color 0.2s;
      }

      .social-icon:hover {
        background: var(--color-accent-subtle);
        color: var(--color-accent);
        border-color: rgba(246, 87, 0, 0.3);
        transform: translateY(-2px);
      }

      .social-icon svg {
        width: 16px;
        height: 16px;
      }

      .footer-newsletter {
        margin-top: 0.2rem;
      }

      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 0;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-legal {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .footer-legal-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #9a9997;
      }

      .footer-legal a {
        font-size: 0.78rem;
        color: #9a9997;
        text-decoration: none;
        transition: color 0.15s;
      }

      .footer-legal a:hover {
        color: var(--color-accent);
      }

      .footer-copyright p,
      .footer-credit p {
        font-size: 0.78rem;
        color: #6b6b68;
        margin: 0;
        text-align: center;
      }

      .footer-credit p {
        color: #9a9997;
      }

      /* ── Utilities ─────────────────────────────── */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* ── Responsive: Tablet ────────────────────── */
      @media (max-width: 768px) {
        /* Show hamburger, hide desktop nav */
        .mobile-menu-btn {
          display: flex;
          margin-left: 0;
        }

        .mobile-theme-toggle {
          display: inline-flex;
          margin-left: auto;
        }

        .logo-subtext {
          display: block;
          margin-left: 0;
          margin-top: 0.1rem;
          font-size: 0.78rem;
          line-height: 1.1;
          opacity: 0.85;
        }

        .logo-text-full {
          display: inline-flex;
          flex-direction: column;
          align-items: flex-start;
          max-width: none;
          font-size: 0.9rem;
          line-height: 1.1;
        }

        .header-nav-wrap {
          display: none;
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: var(--color-bg);
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 80px 1.5rem 1.5rem;
          overflow-y: auto;
          z-index: 99;
        }

        .header-nav-wrap.open {
          display: flex;
        }

        .site-header nav {
          flex-direction: column;
          gap: 0.3rem;
          margin-left: 0;
          flex: 0 0 auto;
        }

        .site-header nav a {
          font-size: 1rem;
          padding: 0.8em 1em;
          border-radius: 10px;
        }

        .header-actions {
          margin-left: 0;
          margin-top: 0.35rem;
          padding-top: 0.35rem;
          border-top: 1px solid var(--color-border);
          justify-content: flex-start;
          gap: 0.5rem;
        }

        .header-actions .header-icon-btn {
          width: 36px;
          height: 36px;
        }

        .desktop-theme-toggle {
          display: none;
        }

        .header-actions .btn-newsletter {
          display: inline-flex;
          flex: 0 0 auto;
          justify-content: center;
          padding: 0.7em 1.2em;
          font-size: 0.9rem;
        }

        /* Footer */
        .footer-top {
          grid-template-columns: 1fr 1fr;
          gap: 2rem;
        }

        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }

        .footer-legal {
          flex-wrap: wrap;
          justify-content: center;
        }
      }

      /* ── Responsive: Small phone ───────────────── */
      @media (max-width: 480px) {
        .footer-top {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .footer-bottom {
          gap: 0.6rem;
        }

        .footer-legal {
          flex-direction: column;
          gap: 0.5rem;
        }
      }
    /* ── Search Modal ──────────────────────────── */
    .search-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 8vh;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .search-modal.open {
      opacity: 1;
      pointer-events: all;
    }

    .search-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .search-box {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 600px;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(246,87,0,0.15);
      overflow: hidden;
      transform: translateY(-16px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      margin: 0 1rem;
    }

    .search-modal.open .search-box {
      transform: translateY(0) scale(1);
    }

    .search-input-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.1));
    }

    .search-icon-inner {
      width: 20px;
      height: 20px;
      color: var(--color-muted, #a09880);
      flex-shrink: 0;
    }

    #search-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      font-family: inherit;
      font-size: 1.05rem;
      color: var(--color-text, #f0ede8);
      caret-color: var(--color-accent, #f65700);
    }

    #search-input::placeholder {
      color: var(--color-muted, #a09880);
    }

    .search-close-btn {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--color-muted, #a09880);
      padding: 0.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      flex-shrink: 0;
      transition: color 0.15s, background 0.15s;
    }

    .search-close-btn:hover {
      color: var(--color-text, #f0ede8);
      background: rgba(255,255,255,0.05);
    }

    .search-close-btn svg {
      width: 18px;
      height: 18px;
    }

    .search-results {
      max-height: 420px;
      overflow-y: auto;
      padding: 0.5rem;
    }

    .search-results::-webkit-scrollbar {
      width: 4px;
    }

    .search-results::-webkit-scrollbar-track {
      background: transparent;
    }

    .search-results::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.15);
      border-radius: 4px;
    }

    .search-empty {
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--color-muted, #a09880);
      font-size: 0.95rem;
    }

    .search-empty .search-empty-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .search-result-item {
      display: flex;
      align-items: flex-start;
      gap: 0.875rem;
      padding: 0.875rem 0.75rem;
      border-radius: 10px;
      text-decoration: none;
      color: var(--color-text, #f0ede8);
      transition: background 0.15s;
      cursor: pointer;
      border: 1px solid transparent;
    }

    .search-result-item:hover,
    .search-result-item.active {
      background: rgba(246, 87, 0, 0.08);
      border-color: rgba(246, 87, 0, 0.2);
    }

    .search-result-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(246, 87, 0, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 1rem;
    }

    .search-result-content {
      flex: 1;
      min-width: 0;
    }

    .search-result-title {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 0.2rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .search-result-title mark {
      background: transparent;
      color: var(--color-accent, #f65700);
      font-weight: 700;
    }

    .search-result-meta {
      font-size: 0.78rem;
      color: var(--color-muted, #a09880);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .search-result-arrow {
      color: var(--color-muted, #a09880);
      flex-shrink: 0;
      opacity: 0;
      transition: opacity 0.15s;
    }

    .search-result-item:hover .search-result-arrow,
    .search-result-item.active .search-result-arrow {
      opacity: 1;
      color: var(--color-accent, #f65700);
    }

    .search-footer {
      display: flex;
      gap: 1.25rem;
      padding: 0.625rem 1.25rem;
      border-top: 1px solid var(--color-border, rgba(255,255,255,0.1));
      font-size: 0.72rem;
      color: var(--color-muted, #a09880);
    }

    .search-footer span {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    /* ── Notion quote colors ────────────────── */
    /* Text colors */
    .notion-quote.notion-color-gray   { color: #9b9a97 !important; border-left-color: #9b9a97 !important; background: rgba(155,154,151,.08) !important; }
    .notion-quote.notion-color-brown  { color: #64473a !important; border-left-color: #64473a !important; background: rgba(100,71,58,.08)  !important; }
    .notion-quote.notion-color-orange { color: #d9730d !important; border-left-color: #d9730d !important; background: rgba(217,115,13,.08) !important; }
    .notion-quote.notion-color-yellow { color: #cb912f !important; border-left-color: #cb912f !important; background: rgba(203,145,47,.08) !important; }
    .notion-quote.notion-color-green  { color: #448361 !important; border-left-color: #448361 !important; background: rgba(68,131,97,.08)  !important; }
    .notion-quote.notion-color-blue   { color: #337ea9 !important; border-left-color: #337ea9 !important; background: rgba(51,126,169,.08) !important; }
    .notion-quote.notion-color-purple { color: #9065b0 !important; border-left-color: #9065b0 !important; background: rgba(144,101,176,.08) !important; }
    .notion-quote.notion-color-pink   { color: #c14d8a !important; border-left-color: #c14d8a !important; background: rgba(193,77,138,.08) !important; }
    .notion-quote.notion-color-red    { color: #d44c47 !important; border-left-color: #d44c47 !important; background: rgba(212,76,71,.08)  !important; }

    /* Background colors — light mode */
    .notion-quote.notion-color-gray_background   { background: #f1f1ef !important; border-left-color: #9b9a97 !important; }
    .notion-quote.notion-color-brown_background  { background: #f4eeee !important; border-left-color: #64473a !important; }
    .notion-quote.notion-color-orange_background { background: #fbecdd !important; border-left-color: #d9730d !important; }
    .notion-quote.notion-color-yellow_background { background: #fbf3db !important; border-left-color: #cb912f !important; }
    .notion-quote.notion-color-green_background  { background: #edf3ec !important; border-left-color: #448361 !important; }
    .notion-quote.notion-color-blue_background   { background: #e7f3f8 !important; border-left-color: #337ea9 !important; }
    .notion-quote.notion-color-purple_background { background: #f4f0f7 !important; border-left-color: #9065b0 !important; }
    .notion-quote.notion-color-pink_background   { background: #f9eff4 !important; border-left-color: #c14d8a !important; }
    .notion-quote.notion-color-red_background    { background: #fdebec !important; border-left-color: #d44c47 !important; }

    /* Background colors — dark mode */
    [data-theme="dark"] .notion-quote.notion-color-gray_background   { background: rgba(155,154,151,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-brown_background  { background: rgba(100,71,58,.25)   !important; }
    [data-theme="dark"] .notion-quote.notion-color-orange_background { background: rgba(217,115,13,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-yellow_background { background: rgba(203,145,47,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-green_background  { background: rgba(68,131,97,.15)  !important; }
    [data-theme="dark"] .notion-quote.notion-color-blue_background   { background: rgba(51,126,169,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-purple_background { background: rgba(144,101,176,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-pink_background   { background: rgba(193,77,138,.15) !important; }
    [data-theme="dark"] .notion-quote.notion-color-red_background    { background: rgba(212,76,71,.15)  !important; }

    /* Dark mode text color adjustments (lighter tones for readability) */
    [data-theme="dark"] .notion-quote.notion-color-brown  { color: #c1957a !important; }
    [data-theme="dark"] .notion-quote.notion-color-green  { color: #6db890 !important; }

    </style>

    <script>
      // Theme toggle
      const toggles = document.querySelectorAll("[data-theme-toggle]");
      const html = document.documentElement;

      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        html.setAttribute("data-theme", "dark");
      }

      toggles.forEach((toggleEl) => {
        toggleEl.addEventListener("click", () => {
          const isDark = html.getAttribute("data-theme") === "dark";
          html.setAttribute("data-theme", isDark ? "light" : "dark");
          localStorage.setItem("theme", isDark ? "light" : "dark");
        });
      });

      // Mobile menu toggle
      const menuBtn = document.getElementById("mobile-menu-btn");
      const navWrap = document.getElementById("header-nav-wrap");

      menuBtn?.addEventListener("click", () => {
        menuBtn.classList.toggle("active");
        navWrap?.classList.toggle("open");
        
        const header = document.querySelector(".site-header");
        header?.classList.toggle("menu-open");
        
        document.body.style.overflow = navWrap?.classList.contains("open")
          ? "hidden"
          : "";
      });

      // Close mobile menu when clicking any nav link
      navWrap?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuBtn?.classList.remove("active");
          navWrap?.classList.remove("open");
          document.body.style.overflow = "";
          document.querySelector(".site-header")?.classList.remove("menu-open");
        });
      });

      // ── Search Modal ──────────────────────────────
      const searchToggle = document.getElementById("search-toggle");
      const searchModal = document.getElementById("search-modal");
      const searchBackdrop = document.getElementById("search-backdrop");
      const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
      const searchResults = document.getElementById("search-results");
      const searchClose = document.getElementById("search-close");

      // Static blog posts — fetched once from the blog listing
      interface PostEntry {
        title: string;
        slug: string;
        tags: string[];
        date: string;
        emoji: string;
      }

      let allPosts: PostEntry[] = [];
      let activeIndex = -1;

      async function loadPosts() {
        if (allPosts.length > 0) return;
        try {
          const res = await fetch("/blog");
          const html = await res.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, "text/html");
          // PostCard items — class is "card" on <article>
          const cards = doc.querySelectorAll("article.card");
          cards.forEach((card) => {
            const titleEl = card.querySelector(".title a");
            const linkEl = card.querySelector("a");
            const timeEl = card.querySelector("time");
            const tagEls = card.querySelectorAll(".tag");
            const initial = card.querySelector(".cover-initial");
            if (titleEl && linkEl) {
              allPosts.push({
                title: titleEl.textContent?.trim() ?? "",
                slug: linkEl.getAttribute("href") ?? "/blog",
                tags: Array.from(tagEls).map((t) => t.textContent?.trim() ?? ""),
                date: timeEl?.textContent?.trim() ?? "",
                emoji: initial?.textContent?.trim() ?? "📄",
              });
            }
          });
        } catch (e) {
          console.warn("Não foi possível carregar posts para busca.", e);
        }
      }

      function highlightText(text: string, query: string): string {
        if (!query) return text;
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        return text.replace(
          new RegExp(`(${escaped})`, "gi"),
          "<mark>$1</mark>"
        );
      }

      function renderResults(query: string) {
        if (!searchResults) return;
        activeIndex = -1;

        if (!query.trim()) {
          searchResults.innerHTML = `
            <div class="search-empty">
              <div class="search-empty-icon">🔍</div>
              <p>Digite para buscar artigos...</p>
            </div>`;
          return;
        }

        const lower = query.toLowerCase();
        const filtered = allPosts.filter(
          (p) =>
            p.title.toLowerCase().includes(lower) ||
            p.tags.some((t) => t.toLowerCase().includes(lower))
        );

        if (filtered.length === 0) {
          searchResults.innerHTML = `
            <div class="search-empty">
              <div class="search-empty-icon">😔</div>
              <p>Nenhum artigo encontrado para "${query}"</p>
            </div>`;
          return;
        }

        searchResults.innerHTML = filtered
          .slice(0, 8)
          .map(
            (p, i) => `
            <a href="${p.slug}" class="search-result-item" data-index="${i}">
              <div class="search-result-icon">${p.emoji}</div>
              <div class="search-result-content">
                <div class="search-result-title">${highlightText(p.title, query)}</div>
                <div class="search-result-meta">
                  ${p.date}${p.tags.length ? " · " + p.tags.slice(0, 3).join(", ") : ""}
                </div>
              </div>
              <svg class="search-result-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>`
          )
          .join("");
      }

      function openSearch() {
        if (navWrap?.classList.contains("open")) {
          menuBtn?.classList.remove("active");
          navWrap?.classList.remove("open");
          document.querySelector(".site-header")?.classList.remove("menu-open");
        }
        searchModal?.classList.add("open");
        document.body.style.overflow = "hidden";
        setTimeout(() => searchInput?.focus(), 50);
        renderResults("");
        loadPosts();
      }

      function closeSearch() {
        searchModal?.classList.remove("open");
        document.body.style.overflow = "";
        if (searchInput) searchInput.value = "";
        activeIndex = -1;
      }

      searchToggle?.addEventListener("click", openSearch);
      searchClose?.addEventListener("click", closeSearch);
      searchBackdrop?.addEventListener("click", closeSearch);

      searchInput?.addEventListener("input", () => {
        renderResults(searchInput.value);
      });

      // Keyboard navigation
      searchInput?.addEventListener("keydown", (e) => {
        const items = searchResults?.querySelectorAll(".search-result-item");
        if (!items || items.length === 0) return;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
          items.forEach((el, i) => el.classList.toggle("active", i === activeIndex));
          (items[activeIndex] as HTMLElement).scrollIntoView({ block: "nearest" });
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
          items.forEach((el, i) => el.classList.toggle("active", i === activeIndex));
          (items[activeIndex] as HTMLElement).scrollIntoView({ block: "nearest" });
        } else if (e.key === "Enter") {
          e.preventDefault();
          const active = searchResults?.querySelector(".search-result-item.active") as HTMLAnchorElement | null;
          if (active) window.location.href = active.href;
        }
      });

      document.addEventListener("keydown", (e) => {
        if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || e.key === "/") {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          e.preventDefault();
          searchModal?.classList.contains("open") ? closeSearch() : openSearch();
        }
        if (e.key === "Escape" && searchModal?.classList.contains("open")) {
          closeSearch();
        }
      });
    </script>
    <ExitIntentPopup />
    <CookieConsent />
  </body>
</html>
