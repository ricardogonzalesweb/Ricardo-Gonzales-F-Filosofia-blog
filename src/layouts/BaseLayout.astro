---
import { SEO } from "astro-seo";
import ExitIntentPopup from "../components/ExitIntentPopup.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  schema?: Record<string, any>;
}

const {
  title = "Ricardo Gonzales Fé & Filosofia",
  description = "Reflexões sobre Fé Católica e Filosofia. Novos artigos toda semana.",
  ogImage,
  schema,
} = Astro.props;

const siteName = "Ricardo Gonzales Fé & Filosofia";
const siteTitle = title.includes("Ricardo Gonzales")
  ? title
  : `${title} | ${siteName}`;

const siteUrl = Astro.site ?? import.meta.env.SITE ?? "https://ricardogonzalesoficial.com.br";
const canonicalUrl = Astro.request?.url
  ? new URL(Astro.request.url, siteUrl).toString()
  : siteUrl;
const fullImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`
  : `${siteUrl}/favicon.svg`;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script type="text/partytown" is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NGQM4HC6');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={siteTitle}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: siteTitle,
          type: "website",
          image: fullImage,
          url: canonicalUrl,
        },
        image: {
          alt: description,
        },
        optional: {
          siteName,
        },
      }}
      twitter={{
        site: "@ricardogonzales",
        card: "summary_large_image",
      }}
    />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NGQM4HC6"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="site-header">
