            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Buscar artigos..."
            autocomplete="off"
            spellcheck="false"
          />
          <button id="search-close" class="search-close-btn" aria-label="Fechar busca">
