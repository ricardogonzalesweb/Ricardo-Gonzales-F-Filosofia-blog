---
interface Props {
  tags: string[];
  currentTag?: string;
}

const { tags, currentTag } = Astro.props;

// Ordena as tags em ordem alfabética para facilitar a busca do usuário
const sortedTags = [...tags].sort((a, b) => a.localeCompare(b, "pt-BR"));
---

<div class="tags-dropdown-wrapper">
  <details class="tags-dropdown">
    <summary class="tags-dropdown-trigger">
      <span class="trigger-label">Filtrar por Assunto</span>
      <span class="active-tag-name">{currentTag || "Todos"}</span>
      <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="tags-dropdown-content">
      <div class="tags-list">
        <a href="/blog" class={`tag-dropdown-item ${!currentTag ? "active" : ""}`}>
          <span class="tag-bullet">•</span>
          Todos os Artigos
        </a>
        {sortedTags.map((tag) => {
          const isSelected = currentTag?.toLowerCase() === tag.toLowerCase();
          return (
            <a
              href={`/blog/tag/${tag.toLowerCase()}`}
              class={`tag-dropdown-item ${isSelected ? "active" : ""}`}
            >
              <span class="tag-bullet">#</span>
              {tag}
            </a>
          );
        })}
      </div>
    </div>
  </details>
</div>

<script>
  // Fecha o menu de tags se clicar fora do elemento dropdown
  document.addEventListener("click", (event) => {
    const dropdowns = document.querySelectorAll(".tags-dropdown");
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) {
        dropdown.removeAttribute("open");
      }
    });
  });
</script>

<style>
  .tags-dropdown-wrapper {
    margin-bottom: 2.5rem;
  }

  .tags-dropdown {
    position: relative;
    display: inline-block;
    z-index: 20;
  }

  .tags-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    list-style: none; /* Esconde o triângulo padrão do summary */
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-text);
    box-shadow: 0 4px 12px var(--color-shadow);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    user-select: none;
    outline: none;
  }

  /* Remove o marcador do sumário no Safari */
  .tags-dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .tags-dropdown-trigger:hover {
    border-color: var(--color-accent);
    box-shadow: 0 6px 16px rgba(246, 87, 0, 0.15);
  }

  .tags-dropdown[open] .tags-dropdown-trigger {
    border-color: var(--color-accent);
    box-shadow: 0 6px 16px rgba(246, 87, 0, 0.18);
    background: var(--color-card);
  }

  .trigger-label {
    color: var(--color-muted);
    font-weight: 500;
  }

  .active-tag-name {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .chevron-icon {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--color-muted);
  }

  .tags-dropdown[open] .chevron-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .tags-dropdown-content {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 280px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    animation: slideDown 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .tags-list {
    max-height: 280px;
    overflow-y: auto;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tag-dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s, padding-left 0.2s;
  }

  .tag-bullet {
    opacity: 0.4;
    font-weight: bold;
    font-size: 0.95rem;
    transition: opacity 0.15s;
  }

  .tag-dropdown-item:hover {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    padding-left: 0.95rem;
  }

  .tag-dropdown-item:hover .tag-bullet {
    opacity: 0.8;
  }

  .tag-dropdown-item.active {
    background: var(--color-accent);
    color: #fff;
  }

  .tag-dropdown-item.active .tag-bullet {
    opacity: 1;
  }
</style>
