---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contato"
  description="Entre em contato conosco. Envie sua mensagem, dúvida ou sugestão."
  ogImage="/og-images/default-og.svg"
>
  <section class="page-hero">
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <span class="page-badge">✦ FALE CONOSCO</span>
      <h1 class="page-title">Entre em <span class="accent">Contato</span></h1>
      <p class="page-sub">
        Tem alguma dúvida, sugestão ou deseja compartilhar algo? Ficaremos
        felizes em ouvir você.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <form class="contact-form" id="contact-form">
          <input type="text" name="hp_field" autocomplete="off" tabindex="-1" class="hp-field" />
          <div class="form-group">
            <label for="name">Nome completo</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Seu nome"
              required
            />
          </div>
          <div class="form-group">
            <label for="email">E-mail</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="seu@email.com"
              required
            />
          </div>
          <div class="form-group">
            <label for="subject">Assunto</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Sobre o que deseja falar?"
              required
            />
          </div>
          <div class="form-group">
            <label for="message">Mensagem</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Escreva sua mensagem aqui..."
              required></textarea>
          </div>
          <div class="form-group consent-group">
            <label class="consent-label">
              <input type="checkbox" id="consent" name="consent" />
              <span>Aceito ser contatado por e-mail para resposta desta mensagem.</span>
            </label>
          </div>
          <button type="submit" class="btn-submit"
            >Enviar mensagem &nbsp;→</button
          >
          <p id="contact-feedback" class="form-feedback" aria-live="polite"></p>
        </form>

        <aside class="contact-info">
          <div class="info-card">
            <div class="info-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path><polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <h3>E-mail</h3>
            <p>contato@ricardogonzalesoficial.com.br
          </div>

          <div class="info-card">
            <a
              href="https://www.google.com/maps/place/Andradas+-+Minas+Gerais,+Brasil"
              target="_blank"
              rel="noopener noreferrer"
              class="info-card-link"
            >
              <div class="info-icon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"
                  ></path><circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <h3>Localização</h3>
              <p>Andradas Minas Gerais, Brasil</p>
            </a>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3>Horário</h3>
            <p>Respondemos em até 48 horas</p>
          </div>

          <div class="social-row">
            <h3>Redes Sociais</h3>
            <div class="social-links">
              <a
                href="https://www.instagram.com/ricardogonzalesoficial/"
                aria-label="Instagram"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://www.youtube.com/@ricardogonzalesoficial"
                aria-label="YouTube"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://whatsapp.com/channel/0029VbB43pfAjPXMWpyOks1h"
                aria-label="WhatsApp"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Page Hero ───────────────────────────── */
  .page-hero {
    position: relative;
    background: #0e0d0c;
    color: #f0ede8;
    padding: 5rem 0 3.5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -40%);
    width: 700px;
    height: 500px;
    background: radial-gradient(
      ellipse at center,
      rgba(246, 87, 0, 0.12) 0%,
      rgba(246, 87, 0, 0.04) 40%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .page-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    background: rgba(246, 87, 0, 0.1);
    border: 1px solid rgba(246, 87, 0, 0.25);
    padding: 0.45em 1.2em;
    border-radius: 50px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .accent {
    color: var(--color-accent);
  }

  .page-sub {
    max-width: 500px;
    color: #9a9997;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Contact Section ─────────────────────── */
  .contact-section {
    padding: 4rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  /* ── Form ─────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-body);
    font-size: 0.92rem;
    padding: 0.85em 1em;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card);
    color: var(--color-text);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    resize: vertical;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .consent-group {
    margin-top: -0.2rem;
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
    text-transform: none;
    letter-spacing: normal;
  }

  .consent-label input {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    opacity: 0;
    cursor: pointer;
  }

  .consent-label span {
    position: relative;
    padding-left: 2.2rem;
  }

  .consent-label span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1.4rem;
    height: 1.4rem;
    border: 2px solid var(--color-accent);
    border-radius: 0.4rem;
    background: var(--color-card);
    transition: background 0.2s, border-color 0.2s;
  }

  .consent-label input:checked + span::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .consent-label input:checked + span::after {
    content: "";
    position: absolute;
    left: 0.4rem;
    top: 0.55rem;
    width: 0.35rem;
    height: 0.7rem;
    border: solid #fff;
    border-width: 0 0.18rem 0.18rem 0;
    transform: rotate(45deg);
  }

  .form-feedback {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-muted);
    min-height: 1.2rem;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-muted);
    opacity: 0.6;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(246, 87, 0, 0.12);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85em 2em;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .btn-submit:hover {
    background: #d74800;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(246, 87, 0, 0.35);
  }

  /* ── Info sidebar ────────────────────────── */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .info-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .info-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--color-shadow);
  }

  .info-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .info-card-link:hover {
    color: inherit;
  }

  .info-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border-radius: 10px;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }

  .info-icon svg {
    width: 20px;
    height: 20px;
  }

  .info-card h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
  }

  .info-card p {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  .social-row {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.4rem;
  }

  .social-row h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.8rem;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
  }

  .social-link {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border: 1px solid rgba(246, 87, 0, 0.15);
    border-radius: 10px;
    color: var(--color-accent);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, border-color 0.2s;
  }

  .social-link:hover {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;
  const feedback = document.getElementById("contact-feedback") as HTMLElement | null;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form?.querySelector(".btn-submit") as HTMLButtonElement | null;
    if (!form || !btn) return;

    btn.disabled = true;
    btn.textContent = "Enviando...";
    if (feedback) feedback.textContent = "";

    const payload = {
      name: (form.querySelector("#name") as HTMLInputElement)?.value ?? "",
      email: (form.querySelector("#email") as HTMLInputElement)?.value ?? "",
      subject: (form.querySelector("#subject") as HTMLInputElement)?.value ?? "",
      message: (form.querySelector("#message") as HTMLTextAreaElement)?.value ?? "",
      consent: (form.querySelector("#consent") as HTMLInputElement)?.checked ?? false,
      hp_field: (form.querySelector("input[name='hp_field']") as HTMLInputElement)?.value ?? "",
    };

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!response.ok || !data.ok) {
        throw new Error(data.error || "Falha no envio.");
      }

      btn.textContent = "✓ Mensagem enviada!";
      btn.style.background = "#16a34a";
      if (feedback) feedback.textContent = "Recebemos sua mensagem. Obrigado pelo contato.";
      form.reset();
    } catch (error) {
      btn.textContent = "Tentar novamente";
      btn.style.background = "#dc2626";
      if (feedback) feedback.textContent = "Nao foi possivel enviar agora. Tente novamente em instantes.";
    } finally {
      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = "Enviar mensagem  →";
        btn.style.background = "";
      }, 2200);
    }
  });
</script>
