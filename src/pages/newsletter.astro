---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Newsletter" description="Inscreva-se na nossa newsletter e receba artigos sobre Fé Católica e Filosofia diretamente no seu e-mail." ogImage="/og-images/default-og.svg">
  <section class="page-hero">
    <div class="hero-glow"></div>
    <span class="hero-cross" style="top:15%;left:10%">+</span>
    <span class="hero-cross" style="top:10%;right:12%">+</span>
    <span class="hero-cross" style="top:60%;left:6%">+</span>
    <span class="hero-cross" style="top:55%;right:8%">+</span>
    <div class="container hero-content">
      <span class="page-badge">✦ NEWSLETTER</span>
      <h1 class="page-title">Receba <span class="accent">inspiração</span><br/>na sua caixa de entrada</h1>
      <p class="page-sub">Artigos semanais sobre Fé Católica e Filosofia. Gratuito, sem spam, e você pode cancelar a qualquer momento.</p>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-card">
        <div class="newsletter-left">
          <div class="nl-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h2>Inscreva-se gratuitamente</h2>
          <p>Junte-se a outros leitores que buscam reflexões profundas sobre fé e razão.</p>

          <form class="nl-form" id="newsletter-form">
            <input type="text" name="hp_field" autocomplete="off" tabindex="-1" class="hp-field" />
            <div class="nl-input-group">
              <input type="email" id="nl-email" name="email" placeholder="seu@email.com" required />
            </div>
            <label class="nl-consent">
              <input type="checkbox" id="nl-consent" name="consent" required />
              <span>Aceito receber e-mails da newsletter e posso cancelar quando quiser.</span>
            </label>
            <button type="submit" class="btn-subscribe">
              <span>Inscrever-se agora</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
            <p id="newsletter-feedback" class="nl-feedback" aria-live="polite"></p>
          </form>

          <p class="nl-disclaimer">
            🔒 Seus dados estão seguros. Leia nossa <a href="/privacidade">Política de Privacidade</a>.
          </p>
        </div>

        <div class="newsletter-right">
          <div class="benefit">
            <div class="benefit-icon">📬</div>
            <div>
              <h3>Artigos semanais</h3>
              <p>Receba reflexões cuidadosamente escritas sobre Fé e Filosofia toda semana.</p>
            </div>
          </div>
          <div class="benefit">
            <div class="benefit-icon">🎯</div>
            <div>
              <h3>Conteúdo exclusivo</h3>
              <p>Acesso a artigos e reflexões que não são publicados no blog.</p>
            </div>
          </div>
          <div class="benefit">
            <div class="benefit-icon">💡</div>
            <div>
              <h3>100% Gratuito</h3>
              <p>Sem custos, sem spam. Cancele quando quiser com um clique.</p>
            </div>
          </div>
          <div class="benefit">
            <div class="benefit-icon">🤝</div>
            <div>
              <h3>Comunidade</h3>
              <p>Faça parte de uma comunidade que busca a verdade pela fé e razão.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    background: #0e0d0c;
    color: #f0ede8;
    padding: 5rem 0 3.5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -40%);
    width: 700px;
    height: 500px;
    background: radial-gradient(ellipse at center, rgba(246, 87, 0, 0.12) 0%, rgba(246, 87, 0, 0.04) 40%, transparent 70%);
    pointer-events: none;
  }

  .hero-cross {
    position: absolute;
    color: rgba(246, 87, 0, 0.3);
    font-size: 0.85rem;
    font-weight: 300;
    pointer-events: none;
    animation: cross-pulse 4s ease-in-out infinite;
  }

  .hero-cross:nth-child(2n) { animation-delay: 2s; }

  @keyframes cross-pulse {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.65; }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .page-badge {
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    background: rgba(246, 87, 0, 0.1);
    border: 1px solid rgba(246, 87, 0, 0.25);
    padding: 0.45em 1.2em;
    border-radius: 50px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .accent { color: var(--color-accent); }

  .page-sub {
    max-width: 520px;
    color: #9a9997;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Newsletter Section ──────────────────── */
  .newsletter-section {
    padding: 4rem 0;
  }

  .newsletter-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 3rem;
    align-items: flex-start;
  }

  .newsletter-left h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .newsletter-left > p {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .nl-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border-radius: 14px;
    color: var(--color-accent);
    margin-bottom: 1.2rem;
  }

  .nl-icon svg {
    width: 28px;
    height: 28px;
  }

  .nl-form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .nl-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    position: relative;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .nl-consent input {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    opacity: 0;
    cursor: pointer;
  }

  .nl-consent span {
    position: relative;
    padding-left: 2.2rem;
  }

  .nl-consent span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1.4rem;
    height: 1.4rem;
    border: 2px solid var(--color-accent);
    border-radius: 0.4rem;
    background: var(--color-card);
    transition: background 0.2s, border-color 0.2s;
  }

  .nl-consent input:checked + span::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .nl-consent input:checked + span::after {
    content: "";
    position: absolute;
    left: 0.45rem;
    top: 0.55rem;
    width: 0.35rem;
    height: 0.7rem;
    border: solid #fff;
    border-width: 0 0.18rem 0.18rem 0;
    transform: rotate(45deg);
  }

  .nl-feedback {
    margin: 0.1rem 0 0;
    font-size: 0.82rem;
    color: var(--color-muted);
    min-height: 1.2rem;
  }

  .nl-input-group input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.92rem;
    padding: 0.85em 1em;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .nl-input-group input::placeholder {
    color: var(--color-muted);
    opacity: 0.6;
  }

  .nl-input-group input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(246, 87, 0, 0.12);
  }

  .btn-subscribe {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.9em 2em;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    margin-top: 0.3rem;
  }

  .btn-subscribe:hover {
    background: #d74800;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(246, 87, 0, 0.35);
  }

  .nl-disclaimer {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin: 0;
  }

  .nl-disclaimer a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nl-disclaimer a:hover {
    text-decoration: underline;
  }

  /* ── Benefits ────────────────────────────── */
  .newsletter-right {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .benefit {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.2rem;
    border-radius: 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .benefit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--color-shadow);
  }

  .benefit-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-subtle);
    border-radius: 10px;
  }

  .benefit h3 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }

  .benefit p {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .newsletter-card {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
  }
</style>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('newsletter-feedback') as HTMLElement | null;
  const status = new URLSearchParams(window.location.search).get("status");
  if (feedback && status) {
    if (status === "confirmed") feedback.textContent = "Inscricao confirmada com sucesso.";
    if (status === "unsubscribed") feedback.textContent = "Seu descadastro foi concluido.";
    if (status === "invalid") feedback.textContent = "Link invalido ou expirado.";
    if (status === "error") feedback.textContent = "Nao foi possivel processar sua solicitacao.";
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form?.querySelector('.btn-subscribe span') as HTMLElement | null;
    const buttonElement = form?.querySelector('.btn-subscribe') as HTMLButtonElement | null;
    if (!btn || !buttonElement || !form) return;

    buttonElement.disabled = true;
    btn.textContent = "Enviando...";
    if (feedback) feedback.textContent = "";

    const payload = {
      email: (form.querySelector("#nl-email") as HTMLInputElement)?.value ?? "",
      consent: (form.querySelector("#nl-consent") as HTMLInputElement)?.checked ?? false,
      hp_field: (form.querySelector("input[name='hp_field']") as HTMLInputElement)?.value ?? "",
    };

    try {
      const response = await fetch("/api/newsletter/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await response.json();
      if (!response.ok || !data.ok) {
        throw new Error(data.error || "Falha na inscricao.");
      }
      btn.textContent = "✓ Quase la!";
      buttonElement.style.background = "#16a34a";
      if (feedback) feedback.textContent = "Verifique seu e-mail para confirmar a inscricao.";
      form.reset();
    } catch (error) {
      btn.textContent = "Tentar novamente";
      buttonElement.style.background = "#dc2626";
      if (feedback) feedback.textContent = "Nao foi possivel assinar agora. Tente novamente em instantes.";
    } finally {
      setTimeout(() => {
        buttonElement.disabled = false;
        btn.textContent = "Inscrever-se agora";
        buttonElement.style.background = "";
      }, 2200);
    }
  });
</script>
