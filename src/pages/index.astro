---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/notion";

const posts = await getPosts();
const featured = posts[0];
const rest = posts.slice(1, 7);
---


<BaseLayout
  title="Blog - Ricardo Gonzales Fé & Filosofia"
  description="Reflexões sobre Fé Católica e Filosofia. Novos artigos toda semana."
  ogImage="/og-images/default-og.svg"
>
  <section class="hero">
    <div class="hero-glow"></div>
    <canvas id="hero-particles" class="hero-particles-canvas"></canvas>

    <div class="container hero-content">
      <span class="hero-badge">
        <img src="/favicon.svg" alt="" class="hero-badge-icon" />
        BEM-VINDO AO BLOG
      </span>
      <h1 class="hero-title">
        A FÉ ILUMINA,<br />
        <span class="accent">A RAZAO INVESTIGA, A</span><br />
        <span class="accent">VERDADE TRASFORMA</span>
      </h1>
      <p class="hero-sub">
        Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn-primary">Ver todos os artigos &nbsp;→</a>
        <a href="/contato" class="btn-outline-hero">Entrar em contato</a>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">{posts.length}</span>
          <span class="stat-label">ARTIGOS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value accent">100%</span>
          <span class="stat-label">GRATUITO</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value">∞</span>
          <span class="stat-label">INSPIRAÇÃO</span>
        </div>
      </div>

      <div class="hero-scroll">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>
  </section>

  <!-- Faixa Animada (Ticker) -->
  <div class="ticker-wrapper">
    <div class="ticker-content">
      <div class="ticker-track">
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
      </div>
      <div class="ticker-track">
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
        <span>Reflexões sobre Fé Católica, e Filosofia. Novos artigos toda semana.</span>
      </div>
    </div>
  </div>

  {featured && (
    <section class="featured">
      <div class="container">
        <h2 class="section-label">Em destaque</h2>
        <a href={`/blog/${featured.slug}`} class="featured-card">
          {featured.coverImage && (
            <div class="featured-cover">
              <img src={featured.coverImage} alt={featured.title} loading="eager" />
            </div>
          )}
          <div class="featured-body">
            {featured.tags.length > 0 && (
              <div class="featured-tags">
                {featured.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <h3 class="featured-title">{featured.title}</h3>
            {featured.excerpt && <p class="featured-excerpt">{featured.excerpt}</p>}
            <span class="featured-cta">Ler artigo →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="grid-section">
      <div class="container">
        <h2 class="section-label">Publicações recentes</h2>
        <div class="posts-grid">
          {rest.map((post) => <PostCard post={post} />)}
        </div>
        {posts.length > 7 && (
          <div class="more">
            <a href="/blog" class="btn-outline">Ver todos os artigos</a>
          </div>
        )}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <div class="empty">
      <div class="container">
        <p>Ainda não há publicações. Configure o banco de dados no Notion e publique o primeiro artigo!</p>
      </div>
    </div>
  )}
</BaseLayout>

<style>
  /* ── Ticker Banner ───────────────────────── */
  .ticker-wrapper {
    width: 100%;
    overflow: hidden;
    background: var(--color-accent);
    color: #fff;
    padding: 0.65rem 0;
    display: flex;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 10;
    position: relative;
  }

  .ticker-content {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .ticker-track {
    display: flex;
    flex-shrink: 0;
    gap: 3rem;
    padding-right: 3rem;
  }

  .ticker-track span {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
  }

  .ticker-track span::after {
    content: "✦";
    color: rgba(255, 255, 255, 0.6);
  }

  @keyframes marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ── Hero ──────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--color-bg);
    color: var(--color-text);
    padding: 5rem 0 3rem;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    z-index: 0;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -40%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(246, 87, 0, 0.15) 0%, rgba(246, 87, 0, 0.05) 40%, transparent 70%);
    pointer-events: none;
    z-index: -2;
  }

  .hero-particles-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    background: rgba(246, 87, 0, 0.1);
    border: 1px solid rgba(246, 87, 0, 0.25);
    padding: 0.45em 1.2em;
    border-radius: 50px;
  }

  .hero-badge-icon {
    width: 14px;
    height: 14px;
    display: block;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    text-transform: uppercase;
  }

  .accent {
    color: var(--color-accent);
  }

  .hero-sub {
    max-width: 480px;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75em 1.8em;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    border: none;
  }

  .btn-primary:hover {
    background: #d74800;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(246, 87, 0, 0.4);
  }

  .btn-outline-hero {
    display: inline-flex;
    align-items: center;
    padding: 0.75em 1.8em;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s, color 0.2s, transform 0.2s, background 0.2s;
  }

  .btn-outline-hero:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
    background: var(--color-accent-subtle);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .hero-scroll {
    margin-top: 1.5rem;
    color: var(--color-muted);
    animation: scroll-bounce 2s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* ── Sections ─────────────────────────────── */
  .section-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin: 0 0 1.6rem; }
  .featured { padding: 4rem 0; border-bottom: 1px solid var(--color-border); }
  .featured-card { display: grid; grid-template-columns: 1fr 1fr; gap: 2.4rem; background: var(--color-card); border: 1px solid var(--color-border); border-radius: 16px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
  .featured-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px var(--color-shadow); }
  .featured-cover { aspect-ratio: 4/3; overflow: hidden; }
  .featured-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .featured-card:hover .featured-cover img { transform: scale(1.04); }
  .featured-body { padding: 2.4rem; display: flex; flex-direction: column; justify-content: center; gap: 0.8rem; }
  .featured-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); background: var(--color-accent-subtle); padding: 0.2em 0.6em; border-radius: 4px; }
  .featured-title { font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; line-height: 1.25; letter-spacing: -0.02em; margin: 0; }
  .featured-excerpt { color: var(--color-muted); line-height: 1.7; margin: 0; }
  .featured-cta { font-weight: 600; color: var(--color-accent); font-size: 0.95rem; margin-top: 0.4rem; }
  .grid-section { padding: 4rem 0; }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.6rem; }
  .more { text-align: center; margin-top: 3rem; }
  .btn-outline { display: inline-block; padding: 0.7em 1.6em; border: 1px solid var(--color-accent); border-radius: 8px; color: var(--color-accent); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: background 0.15s, color 0.15s; }
  .btn-outline:hover { background: var(--color-accent); color: #fff; }
  .empty { padding: 6rem 0; text-align: center; color: var(--color-muted); }

  @media (max-width: 768px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-cover { aspect-ratio: 16/9; }
    .featured-body { padding: 1.6rem; }
    .hero { padding: 3.5rem 0 2rem; min-height: auto; }
    .hero-title { font-size: clamp(1.6rem, 7vw, 2.4rem); }
    .hero-sub { font-size: 0.88rem; }
    .hero-badge { font-size: 0.65rem; }
    .hero-stats { gap: 1.2rem; flex-wrap: wrap; justify-content: center; }
    .stat-value { font-size: 1.2rem; }
    .hero-actions { flex-direction: column; align-items: center; width: 100%; }
    .btn-primary, .btn-outline-hero { width: 100%; justify-content: center; text-align: center; }
    .hero-glow { width: 400px; height: 300px; }
    .posts-grid { grid-template-columns: 1fr; }
    .featured { padding: 3rem 0; }
    .grid-section { padding: 3rem 0; }
  }

  @media (max-width: 400px) {
    .hero-title { font-size: 1.5rem; }
    .hero-stats { gap: 0.8rem; }
    .stat-value { font-size: 1rem; }
    .stat-label { font-size: 0.58rem; }
    .stat-divider { height: 28px; }
  }
</style>

<script>
  interface Particle {
    x: number;
    y: number;
    size: number;
    thickness: number;
    speedY: number;
    swaySpeed: number;
    swayRange: number;
    swayOffset: number;
    angle: number;
    spinSpeed: number;
    opacity: number;
    colorType: 'accent' | 'neutral';
  }

  const canvas = document.getElementById('hero-particles') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let logicalWidth = 0;
      let logicalHeight = 0;

      function resizeCanvas() {
        if (!canvas || !ctx) return;
        const dpr = window.devicePixelRatio || 1;
        const width = canvas.parentElement?.clientWidth || window.innerWidth;
        const height = canvas.parentElement?.clientHeight || window.innerHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.scale(dpr, dpr);
        logicalWidth = width;
        logicalHeight = height;
      }

      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      let accentColor = '#f65700';
      let neutralColor = '#ffffff';

      function updateColors() {
        const html = document.documentElement;
        const isDark = html.getAttribute("data-theme") === "dark" || 
                       (!html.getAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
        neutralColor = isDark ? '#ffffff' : '#1a1a18';
        accentColor = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#f65700';
      }

      updateColors();
      
      const observer = new MutationObserver(() => {
        updateColors();
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      const count = window.innerWidth < 768 ? 20 : 45;
      const particles: Particle[] = [];

      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * (logicalWidth || window.innerWidth),
          y: Math.random() * (logicalHeight || window.innerHeight),
          size: Math.random() * 8 + 8,
          thickness: Math.random() * 1 + 0.5,
          speedY: Math.random() * 0.5 + 0.3,
          swaySpeed: Math.random() * 0.002 + 0.001,
          swayRange: Math.random() * 15 + 5,
          swayOffset: Math.random() * Math.PI * 2,
          angle: Math.random() * Math.PI * 2,
          spinSpeed: (Math.random() - 0.5) * 0.012,
          opacity: Math.random() * 0.22 + 0.08,
          colorType: Math.random() < 0.7 ? 'accent' : 'neutral'
        });
      }

      let mouseX = -1000;
      let mouseY = -1000;
      const mouseRadius = 120;

      const hero = canvas.parentElement;
      if (hero) {
        hero.addEventListener('mousemove', (e) => {
          const mouseEvent = e as MouseEvent;
          const rect = hero.getBoundingClientRect();
          mouseX = mouseEvent.clientX - rect.left;
          mouseY = mouseEvent.clientY - rect.top;
        });

        hero.addEventListener('mouseleave', () => {
          mouseX = -1000;
          mouseY = -1000;
        });
      }

      function animate() {
        if (!ctx || !canvas) return;
        ctx.clearRect(0, 0, logicalWidth, logicalHeight);

        const time = Date.now();

        particles.forEach((p) => {
          // Move down
          p.y += p.speedY;

          // Sway horizontal using time and offset
          const swayX = p.x + Math.sin(time * p.swaySpeed + p.swayOffset) * (p.swayRange * 0.05);

          // Spin
          p.angle += p.spinSpeed;

          // Mouse repulsion
          let finalX = swayX;
          let finalY = p.y;
          
          if (mouseX > -500) {
            const dx = swayX - mouseX;
            const dy = p.y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < mouseRadius) {
              const force = (mouseRadius - dist) / mouseRadius;
              const angle = Math.atan2(dy, dx);
              finalX += Math.cos(angle) * force * 20;
              finalY += Math.sin(angle) * force * 20;
            }
          }

          // Draw Latin Cross
          ctx.save();
          ctx.translate(finalX, finalY);
          ctx.rotate(p.angle);
          ctx.globalAlpha = p.opacity;
          ctx.strokeStyle = p.colorType === 'accent' ? accentColor : neutralColor;
          ctx.lineWidth = p.thickness;
          ctx.lineCap = 'round';
          
          ctx.beginPath();
          // Vertical post (Latin cross proportions)
          ctx.moveTo(0, -p.size * 0.35);
          ctx.lineTo(0, p.size * 0.65);
          // Horizontal beam
          ctx.moveTo(-p.size * 0.3, 0);
          ctx.lineTo(p.size * 0.3, 0);
          
          ctx.stroke();
          ctx.restore();

          // Wrap boundaries
          if (p.y > logicalHeight + 20) {
            p.y = -20;
            p.x = Math.random() * logicalWidth;
            p.speedY = Math.random() * 0.5 + 0.3;
            p.opacity = Math.random() * 0.22 + 0.08;
          }
          if (p.x < -20) {
            p.x = logicalWidth + 20;
          } else if (p.x > logicalWidth + 20) {
            p.x = -20;
          }
        });

        requestAnimationFrame(animate);
      }

      animate();
    }
  }
</script>
