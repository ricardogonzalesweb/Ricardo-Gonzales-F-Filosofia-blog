---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import TagDropdown from "../../../components/TagDropdown.astro";
import { getAllTags, getPostsByTag } from "../../../lib/notion";

const { tag } = Astro.params;
if (!tag) {
  return Astro.redirect("/blog");
}
const allTags = await getAllTags();
const tagLabel = allTags.find((t) => t.toLowerCase() === tag.toLowerCase()) || tag;
const posts = await getPostsByTag(tagLabel);


---

<BaseLayout
  title={`Tag: ${tagLabel}`}
  description={`Artigos sobre ${tagLabel}.`}
  ogImage="/og-images/post-og.svg"
>
  <div class="container">
    <header class="page-header">
      <a href="/blog" class="back">← Todos os artigos</a>
      <h1 class="page-title">
        <span class="tag-pill">{tagLabel}</span>
      </h1>
      <p class="page-sub">{posts.length} artigo{posts.length !== 1 ? "s" : ""}</p>
    </header>

    {allTags.length > 0 && (
      <TagDropdown tags={allTags} currentTag={tagLabel} />
    )}

    {posts.length > 0 ? (
      <div class="posts-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="empty">Nenhum artigo com esta tag ainda.</p>
    )}
  </div>
</BaseLayout>

<style>
  .container { max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem; }
  .page-header { padding: 4rem 0 2rem; }
  .back { font-size: 0.85rem; color: var(--color-muted); text-decoration: none; display: inline-block; margin-bottom: 1.2rem; }
  .back:hover { color: var(--color-accent); }
  .page-title { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 0.4rem; display: flex; align-items: center; gap: 0.6rem; }
  .tag-pill { background: var(--color-accent); color: #fff; padding: 0.1em 0.5em; border-radius: 6px; }
  .page-sub { color: var(--color-muted); margin: 0; }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.6rem; padding-bottom: 4rem; }
  .empty { color: var(--color-muted); padding: 4rem 0; text-align: center; }
</style>

