---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotionRenderer from "../../components/NotionRenderer.astro";
import { formatNotionDate, getPosts, getPostBySlug } from "../../lib/notion";


const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect("/blog");
}

const date = post.publishedAt
  ? formatNotionDate(post.publishedAt, "pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : "";

type TocItem = { id: string; text: string; level: 2 | 3 | 4 };

function slugify(text: string): string {
  return text
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");
}

function extractTocItems(blocks: any[]): TocItem[] {
  const items: TocItem[] = [];

  for (const block of blocks) {
    if (block.type === "heading_1" || block.type === "heading_2" || block.type === "heading_3") {
      const rich = block[block.type]?.rich_text ?? [];
      const text = rich.map((t: any) => t.plain_text).join(" ").trim();
      if (text) {
        items.push({
          id: slugify(text) || block.id,
          text,
          level: block.type === "heading_1" ? 2 : block.type === "heading_2" ? 3 : 4,
        });
      }
    }

    if (Array.isArray(block._children) && block._children.length > 0) {
      items.push(...extractTocItems(block._children));
    }
  }

  return items;
}

const tocItems = extractTocItems(post.blocks);
const latestPosts = (await getPosts())
  .filter((latestPost) => latestPost.slug !== post.slug)
  .slice(0, 2);

// Schema JSON-LD para melhor indexação nos buscadores
const siteUrl = (Astro.site ?? import.meta.env.SITE ?? "https://ricardogonzalesoficial.com.br").toString().replace(/\/$/, "");
const canonicalUrl = Astro.request?.url
  ? new URL(Astro.request.url, siteUrl).toString()
  : siteUrl;
const articleImage = post.coverImage
  ? post.coverImage.startsWith("http")
    ? post.coverImage
    : `${siteUrl}${post.coverImage}`
  : `${siteUrl}/favicon.svg`;

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  image: articleImage,
  datePublished: post.publishedAt,
  author: {
    "@type": "Person",
    name: post.author,
  },
  url: canonicalUrl,
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.coverImage || "/og-images/post-og.svg"}
  schema={schemaArticle}
>
  <article class="post">
    {post.coverImage && (
      <div class="post-cover">
        <img src={articleImage} alt={post.title} loading="eager" />
      </div>
    )}

    <div class="post-container">
      <header class="post-header">
        {post.tags.length > 0 && (
          <div class="post-tags">
            {post.tags.map((tag) => (
              <a href={`/blog/tag/${tag.toLowerCase()}`} class="tag">{tag}</a>
            ))}
          </div>
        )}

        <h1 class="post-title">{post.title}</h1>

        {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}

        <div class="post-meta">
          <span class="post-author">{post.author}</span>
          <span class="meta-separator">•</span>
          <time datetime={post.publishedAt}>{date}</time>
        </div>
      </header>

      <div class="post-content-grid">
        {tocItems.length > 0 && (
          <aside class="post-toc" aria-label="Sumario do artigo">
            <h2>Neste artigo</h2>
            <nav>
              {tocItems.map((item) => (
                <a href={`#${item.id}`} class={`toc-link level-${item.level}`}>{item.text}</a>
              ))}
            </nav>
          </aside>
        )}

        <div class="post-body">
          <NotionRenderer blocks={post.blocks} />
        </div>
      </div>

      <section class="post-share" data-post-excerpt={post.excerpt}>
        <h2>Compartilhar</h2>
        <div class="share-buttons">
          <a class="share-link twitter" data-network="twitter" title="Compartilhar no X">X</a>
          <a class="share-link facebook" data-network="facebook" title="Compartilhar no Facebook">Facebook</a>
          <a class="share-link linkedin" data-network="linkedin" title="Compartilhar no LinkedIn">LinkedIn</a>
          <a class="share-link whatsapp" data-network="whatsapp" title="Compartilhar no WhatsApp">WhatsApp</a>
          <a class="share-link email" data-network="email" title="Compartilhar por e-mail">E-mail</a>
          <button id="copy-link-btn" class="share-link copy-link" title="Copiar link do artigo" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="copy-link-label">Copiar link</span>
          </button>
        </div>
      </section>

      <footer class="post-footer">
        <a href="/blog" class="back-link">← Voltar para artigos</a>
      </footer>

      {latestPosts.length > 0 && (
        <section class="latest-posts" aria-labelledby="latest-posts-title">
          <h2 id="latest-posts-title">Últimos posts</h2>
          <div class="latest-posts-grid">
            {latestPosts.map((latestPost) => (
              <a class="latest-post-card" href={`/blog/${latestPost.slug}`}>
                {latestPost.coverImage ? (
                  <div class="latest-post-cover">
                    <img src={latestPost.coverImage} alt={latestPost.title} loading="lazy" />
                  </div>
                ) : (
                  <div class="latest-post-cover latest-post-cover-placeholder">
                    <span>{latestPost.title[0]?.toUpperCase()}</span>
                  </div>
                )}
                <div class="latest-post-body">
                  <h3>{latestPost.title}</h3>
                  {latestPost.excerpt && <p>{latestPost.excerpt}</p>}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post-cover {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-container {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .post-header {
    padding: 3rem 0 2.4rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.4rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    padding: 0.2em 0.6em;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .tag:hover { background: var(--color-accent-hover); }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .post-excerpt {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 1.2rem;
  }

  .post-meta {
    font-size: 0.85rem;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-author {
    color: var(--color-text);
    font-weight: 600;
  }

  .meta-separator {
    color: var(--color-muted);
  }

  .post-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .post-body {
    padding-bottom: 3rem;
    font-size: 1.05rem;
    min-width: 0;
  }

  .post-toc {
    display: none;
    position: sticky;
    top: 6.2rem;
    align-self: start;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    border-radius: 10px;
    padding: 0.9rem 0.85rem;
    max-height: calc(100vh - 7.5rem);
    overflow: auto;
  }

  .post-toc h2 {
    margin: 0 0 0.7rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .post-toc nav {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }

  .post-toc .toc-link {
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .post-toc .toc-link:hover {
    color: var(--color-accent);
  }

  .post-toc .toc-link.level-3 { padding-left: 0.7rem; }
  .post-toc .toc-link.level-4 { padding-left: 1.4rem; }

  .post-share {
    border-top: 1px solid var(--color-border);
    padding: 1.2rem 0 1rem;
    margin-top: 1.6rem;
  }

  .post-share h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }

  .share-buttons {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .share-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .share-link:hover {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .copy-link {
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .copy-link.copied {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    transform: scale(1.04);
  }

  .post-footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }

  .latest-posts {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0 4rem;
  }

  .latest-posts h2 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .latest-posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .latest-post-card {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
    min-height: 132px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 2px 8px var(--color-shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .latest-post-card:hover {
    transform: translateY(-2px);
    border-color: rgba(246, 87, 0, 0.35);
    box-shadow: 0 8px 24px var(--color-shadow);
  }

  .latest-post-cover {
    width: 140px;
    min-height: 132px;
    background: var(--color-placeholder-bg);
    overflow: hidden;
  }

  .latest-post-cover img {
    width: 100%;
    height: 100%;
    min-height: 132px;
    object-fit: cover;
    display: block;
  }

  .latest-post-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-placeholder-text);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
  }

  .latest-post-body {
    min-width: 0;
    padding: 1rem 1rem 1rem 0;
  }

  .latest-post-body h3 {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.35;
    margin: 0 0 0.45rem;
  }

  .latest-post-body p {
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 780px) {
    .latest-posts-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .latest-post-card {
      grid-template-columns: 1fr;
    }

    .latest-post-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .latest-post-cover img {
      min-height: 0;
    }

    .latest-post-body {
      padding: 0 1rem 1rem;
    }
  }

  @media (min-width: 1100px) {
    .post-container {
      max-width: 1220px;
    }

    .post-content-grid {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: start;
      gap: 2.4rem;
    }

    .post-toc {
      display: block;
    }
  }
</style>

<script>
  // Preenche links de compartilhamento usando a URL atual
  (function () {
    const shareLinks = document.querySelectorAll(".share-link[data-network]");
    if (!shareLinks || shareLinks.length === 0) return;

    const pageUrl = location.href;
    const title = (document.querySelector('.post-title')?.textContent || document.title).trim();
    const excerpt = ((document.querySelector('.post-share') as HTMLElement)?.dataset.postExcerpt || '').trim();
    const u = encodeURIComponent(pageUrl);
    const t = encodeURIComponent(title);
    const d = encodeURIComponent(excerpt);
    const emailBody = encodeURIComponent(
      `${title}\n\n${excerpt ? `${excerpt}\n\n` : ""}Leia o artigo completo:\n${pageUrl}`
    );

    shareLinks.forEach((a) => {
      const net = (a as HTMLElement).dataset.network;
      let href = '#';
      switch (net) {
        case 'twitter':
          href = `https://x.com/intent/tweet?text=${t}&url=${u}`;
          break;
        case 'facebook':
          href = `https://www.facebook.com/sharer/sharer.php?u=${u}`;
          break;
        case 'linkedin':
          href = `https://www.linkedin.com/sharing/share-offsite/?url=${u}`;
          break;
        case 'whatsapp':
          href = `https://api.whatsapp.com/send?text=${t}%0A%0A${d}%0A%0A${u}`;
          break;
        case 'email':
          href = `mailto:?subject=${t}&body=${emailBody}`;
          break;
      }
      a.setAttribute('href', href);
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    });
  })();

  // Botão Copiar Link
  (function () {
    const btn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
    const label = document.getElementById('copy-link-label');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const url = location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Fallback para navegadores sem suporte à Clipboard API
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      label.textContent = 'Copiado!';
      btn.classList.add('copied');
      setTimeout(() => {
        label.textContent = 'Copiar link';
        btn.classList.remove('copied');
      }, 2000);
    });
  })();
</script>
